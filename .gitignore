# --- Sigma benchmark harness .gitignore ---
# Keep: code (*.py, *.js), cases.jsonl, bench_v<N>/*/bench.json (results), judge_verdicts.jsonl.
# Drop: regenerable screenshots/intermediate artifacts (~200M), secrets, caches.

# secrets / env
.env
.env.*
*.benchbak

# per-case screenshots (regenerable) — drop everywhere
*.png
# ...кроме скринов ответов бенча: это визуальное свидетельство прогонов,
# их показывает /benchmark (решение Дани 2026-07-13 — храним в репо)
!eval/bench_v*/*/*.png
!eval/bench_v*/*/figs/*.png
eval/reports/

# stale bench backups/stashes — keep only live eval/bench/*/bench.json
eval/bench.bak*/
eval/bench.*.stash/
eval/bench.phase2_refuse_stash/

# transient run logs + state markers
eval/_*.log
eval/.paid_replace_done
*.log

# python / node caches
__pycache__/
*.pyc
.venv/
node_modules/

# scratch
/tmp/
*.tmp

# scratch (underscore-prefixed) + screenshot dirs
_*
eval/shots/

# лог прогона бенча — артефакт (негация в конце, чтобы перебить *.log выше)
!eval/bench_v*/*/run.log
