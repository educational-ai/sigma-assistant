#!/usr/bin/env python3
"""
Sigma textbook AI assistant — agentic RAG over .qmd chapter sources.

Endpoints:
  GET  /api/model         → current best free model id (cached 5 min)
  POST /api/ask           → single LLM call, no tools
  POST /api/ask_agent     → agent loop with search/read tools over sigma chapters
  GET  /healthz           → {ok, chunks}

Run:
    OPENROUTER_API_KEY=sk-or-... python3 server.py
Env:
    PORT (default 8766), HOST (default 127.0.0.1).
"""

import http.server
import json
import os
import re
import socketserver
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

SIGMA_ROOT = Path("/var/www/sigma")
CHAPTERS_DIRS = [
    SIGMA_ROOT / "book",
    SIGMA_ROOT / "10",
    SIGMA_ROOT / "11",
]

API_KEY = os.environ.get("OPENROUTER_API_KEY", "").strip()
MODEL_ENDPOINT = "https://shir-man.com/api/free-llm/top-models"
OPENROUTER_URL = "https://openrouter.ai/api/v1/chat/completions"
FALLBACK_MODEL = "openrouter/free"

_model_cache = {"id": None, "fetched_at": 0.0}


def fetch_top_model() -> str:
    now = time.time()
    if _model_cache["id"] and now - _model_cache["fetched_at"] < 300:
        return _model_cache["id"]
    try:
        req = urllib.request.Request(
            MODEL_ENDPOINT,
            headers={"User-Agent": "sigma-assistant/0.1 (+sigma.fmin.xyz)"},
        )
        with urllib.request.urlopen(req, timeout=5) as r:
            data = json.loads(r.read())
        model_id = data["models"][0]["id"]
        _model_cache.update(id=model_id, fetched_at=now)
        return model_id
    except Exception as e:
        print(f"[model] fetch failed: {e}", file=sys.stderr)
        return FALLBACK_MODEL


# ----------------------------- Quarto/.qmd parsing ---------------------------

FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---\n", re.DOTALL)
CALLOUT_OPEN_RE = re.compile(r":::\s*\{\.callout[^}]*\}\s*\n", re.IGNORECASE)
FENCED_DIV_RE = re.compile(r":::[\w.\- ]*", re.IGNORECASE)
TOKEN_RE = re.compile(r"\w+", re.UNICODE)


def parse_frontmatter(text: str):
    m = FRONTMATTER_RE.match(text)
    if not m:
        return {}, text
    meta = {}
    for line in m.group(1).split("\n"):
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip().strip('"').strip("'")
    return meta, text[m.end():]


def clean_qmd(body: str) -> str:
    body = CALLOUT_OPEN_RE.sub("", body)
    body = FENCED_DIV_RE.sub("", body)
    return re.sub(r"\n{3,}", "\n\n", body).strip()


def _tokenize(text: str) -> list[str]:
    return [t.lower() for t in TOKEN_RE.findall(text) if len(t) >= 3]


# ----------------------------- Chunk index -----------------------------------

_chunk_index_cache = {"chunks": None, "chapters": None}


def _load_chapter_raw(slug: str):
    for d in CHAPTERS_DIRS:
        p = d / f"{slug}.qmd"
        if p.exists():
            with p.open(encoding="utf-8") as f:
                raw = f.read()
            meta, body = parse_frontmatter(raw)
            title = meta.get("title") or slug.replace("_", " ")
            return title, clean_qmd(body)
    return None


def build_chunk_index(force: bool = False):
    if not force and _chunk_index_cache["chunks"] is not None:
        return _chunk_index_cache["chunks"], _chunk_index_cache["chapters"]
    chunks = []
    chapters_meta = []
    seen = set()
    for d in CHAPTERS_DIRS:
        if not d.exists():
            continue
        for p in sorted(d.glob("*.qmd")):
            slug = p.stem
            if slug in ("index", "preface") or slug in seen:
                continue
            seen.add(slug)
            with p.open(encoding="utf-8") as f:
                raw = f.read()
            meta, body = parse_frontmatter(raw)
            title = meta.get("title") or slug.replace("_", " ")
            body = clean_qmd(body)
            chapters_meta.append({"slug": slug, "title": title, "path": str(p)})
            for idx, para in enumerate(re.split(r"\n\s*\n", body)):
                text = re.sub(r"\s+", " ", para).strip()
                if len(text) < 80:
                    continue
                chunks.append({
                    "slug": slug,
                    "title": title,
                    "idx": idx,
                    "text": text,
                    "tokens": set(_tokenize(text)),
                })
    _chunk_index_cache.update(chunks=chunks, chapters=chapters_meta)
    return chunks, chapters_meta


# ----------------------------- Tools -----------------------------------------

def tool_search(query: str, top_k: int = 3, exclude_slug: str | None = None):
    chunks, _ = build_chunk_index()
    qset = set(_tokenize(query))
    if not qset:
        return []
    scored = []
    for c in chunks:
        if exclude_slug and c["slug"] == exclude_slug:
            continue
        hits = qset & c["tokens"]
        if not hits:
            continue
        text_lower = c["text"].lower()
        bonus = sum(text_lower.count(t) * 0.05 for t in hits)
        scored.append((len(hits) + bonus, c))
    scored.sort(key=lambda x: x[0], reverse=True)
    out = []
    for _, c in scored[:top_k]:
        snippet = c["text"]
        if len(snippet) > 600:
            snippet = snippet[:600] + "…"
        out.append({"slug": c["slug"], "title": c["title"], "snippet": snippet})
    return out


def tool_read_chapter(slug: str, max_chars: int = 6000):
    loaded = _load_chapter_raw(slug)
    if not loaded:
        return None
    title, body = loaded
    truncated = False
    if len(body) > max_chars:
        body = body[:max_chars] + "\n\n[…глава обрезана]"
        truncated = True
    return {"slug": slug, "title": title, "text": body, "truncated": truncated}


# ----------------------------- LLM I/O ---------------------------------------

SYSTEM_PROMPT_PLAIN = (
    "Ты — встроенный помощник учебника по информатике и оптимизации для "
    "10-11 классов (Σ, sigma.fmin.xyz). Тебе дают фрагмент учебника и вопрос. "
    "Отвечай по-русски, кратко, на уровне старшеклассника. Если фрагмент не "
    "содержит ответа — честно скажи и дополни из общих знаний. "
    "Markdown. Формулы ТОЛЬКО $...$ и $$...$$ (не \\(...\\) и не \\[...\\])."
)

AGENT_SYSTEM_PROMPT = (
    "Ты — агентный помощник учебника Σ (sigma.fmin.xyz, информатика и "
    "оптимизация для 10-11 классов). У тебя есть инструменты, чтобы при "
    "необходимости подтянуть материал из других глав. Используй их ТОЛЬКО "
    "когда выделенного фрагмента и текущей главы не хватает.\n\n"
    "Инструменты:\n"
    "1. search(query) — до 3 фрагментов по ключевым словам по всем главам.\n"
    "2. read(slug) — полный текст главы по slug.\n\n"
    "На КАЖДОМ шаге отвечай СТРОГО одним JSON-объектом в блоке ```json ... ```. "
    "Никакого текста до или после блока. Формат:\n"
    "- Поиск: {\"thought\": \"...\", \"tool\": \"search\", \"query\": \"...\"}\n"
    "- Чтение: {\"thought\": \"...\", \"tool\": \"read\", \"slug\": \"...\"}\n"
    "- Финальный ответ: {\"thought\": \"...\", \"answer\": \"markdown ответ\"}\n\n"
    "Максимум 4 шага. Финальный answer: развёрнутый, по-русски, на уровне "
    "старшеклассника, markdown. Формулы ТОЛЬКО $...$ (inline) и $$...$$ "
    "(display). Если ссылаешься на главу — упомяни заголовок. Переносы строк "
    "и абзацы — обычные newline-символы (не пиши литерально \\n)."
)


def _openrouter_chat(messages, model):
    if not API_KEY:
        return None, "OPENROUTER_API_KEY не задан на сервере"
    payload = {"model": model, "messages": messages, "temperature": 0.2}
    req = urllib.request.Request(
        OPENROUTER_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {API_KEY}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://sigma.fmin.xyz",
            "X-Title": "Sigma Assistant",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=90) as r:
            data = json.loads(r.read())
        return data["choices"][0]["message"]["content"], None
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        return None, f"HTTP {e.code}: {body}"
    except Exception as e:
        return None, str(e)


# ----------------------------- JSON parsing helpers --------------------------

_JSON_FENCE_RE = re.compile(r"```(?:json)?\s*(\{[\s\S]*?\})\s*```", re.IGNORECASE)
_BAD_ESC_RE = re.compile(r'\\(?!["\\/bfnrtu])')


def _sanitize_latex_in_json(s: str) -> str:
    return _BAD_ESC_RE.sub(r"\\\\", s)


def _try_json(s: str):
    for c in (s, _sanitize_latex_in_json(s)):
        try:
            return json.loads(c)
        except Exception:
            continue
    return None


def _extract_json(text: str):
    if not text:
        return None
    m = _JSON_FENCE_RE.search(text)
    cands = []
    if m:
        cands.append(m.group(1))
    first = text.find("{")
    last = text.rfind("}")
    if first != -1 and last != -1 and last > first:
        cands.append(text[first : last + 1])
    for c in cands:
        p = _try_json(c)
        if p is not None:
            # If there's an "answer" field, re-extract it via LaTeX-safe regex
            # so JSON escapes (\f, \n, \b, \t, \r) don't mangle LaTeX commands
            # (\frac, \nabla, \beta, \tau, \rho).
            if isinstance(p.get("answer"), str):
                re_ans = _extract_answer_regex(c)
                if re_ans:
                    p["answer"] = re_ans
            return p
    return None


_JSON_ESCAPE_MAP = {"b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}
# Inside math, ambiguous escapes become a real space — KaTeX would choke on
# actual control chars, and visually newlines don't matter inside $$.
_MATH_WS_MAP = {"b": " ", "f": " ", "n": " ", "r": " ", "t": " "}
# Two-letter prefixes of common LaTeX commands starting with the ambiguous
# letters. If after \X the next letter forms a known prefix → real LaTeX
# command; otherwise treat as a JSON whitespace escape. This gates the
# lookahead heuristic from misfiring on `\nf(x)`-style cases where the model
# uses `\n` purely as JSON formatting whitespace.
_LATEX_TWO_LETTER_PREFIXES = {
    "b": {"be", "ba", "bi", "bo", "bm", "br", "bu", "bf"},  # beta, bar, binom, bot, bmod, breve, bullet, bf
    "f": {"fr", "fo", "fl", "fb", "fc", "fa"},               # frac, forall, flat, fbox, fcolorbox, fallingdotseq
    "n": {"na", "no", "ne", "nu", "nl", "ng", "ni"},         # nabla, not, neq/ne, nu, nleq, ngeq, ni
    "r": {"rh", "ri", "ra", "rf", "rc", "re", "ho"},         # rho, rightarrow, rangle, rfloor, rceil, ref, Rho-via-ho
    "t": {"ta", "te", "th", "ti", "to", "tr"},               # tau, text, theta, times/tilde, to/top, triangle
}


def _unescape_json_string_keep_latex(s: str) -> str:
    """Decode escapes inside a JSON string literal while preserving LaTeX
    backslash commands. We track $...$ / $$...$$ math context AND use
    lookahead to disambiguate \\b \\f \\n \\r \\t between JSON whitespace
    escapes and LaTeX commands (\\beta \\frac \\nabla \\rho \\tau)."""
    out = []
    i = 0
    in_math = False
    in_display = False
    n = len(s)
    while i < n:
        c = s[i]
        # $$ / $ math toggling
        if c == "$":
            if i + 1 < n and s[i + 1] == "$":
                if not in_math:
                    in_math = True; in_display = True
                    out.append("$$"); i += 2; continue
                elif in_display:
                    in_math = False; in_display = False
                    out.append("$$"); i += 2; continue
            else:
                if not in_math:
                    in_math = True
                elif not in_display:
                    in_math = False
            out.append("$"); i += 1; continue

        if c != "\\":
            out.append(c); i += 1; continue
        if i + 1 >= n:
            out.append(c); i += 1; continue
        nxt = s[i + 1]

        # Unambiguous JSON escapes — same handling everywhere
        if nxt == '"':
            out.append('"'); i += 2; continue
        if nxt == "\\":
            out.append("\\"); i += 2; continue
        if nxt == "/":
            out.append("/"); i += 2; continue
        if nxt == "u" and i + 5 < n:
            try:
                out.append(chr(int(s[i + 2:i + 6], 16))); i += 6; continue
            except Exception:
                pass

        # Ambiguous: \b \f \n \r \t
        if nxt in _JSON_ESCAPE_MAP:
            j = i + 2
            next_is_letter = j < n and s[j].isascii() and s[j].isalpha()
            if in_math:
                # Inside math, use a 2-letter LaTeX prefix whitelist to
                # disambiguate. `\nabla` (na ∈ whitelist) → LaTeX literal.
                # `\nf(x)=...` (nf ∉ whitelist) → JSON whitespace (space).
                two = nxt + (s[j].lower() if next_is_letter else "")
                if two in _LATEX_TWO_LETTER_PREFIXES.get(nxt, set()):
                    out.append("\\"); out.append(nxt); i += 2; continue
                out.append(_MATH_WS_MAP[nxt]); i += 2; continue
            # Outside math: pure JSON escape decoding
            out.append(_JSON_ESCAPE_MAP[nxt]); i += 2; continue

        # Other \X (a-z but not in bfnrt, or any non-letter) — keep literal.
        # Covers \alpha, \pi, \sin, \cdot, \sum, \approx, ...
        out.append("\\"); out.append(nxt); i += 2
    return "".join(out)


def _extract_answer_regex(text: str):
    """Pull "answer": "..." from a JSON-ish blob without mangling LaTeX."""
    m = re.search(r'"answer"\s*:\s*"((?:[^"\\]|\\.)*)"', text, re.DOTALL)
    if not m:
        return None
    return _unescape_json_string_keep_latex(m.group(1))


# Model sometimes injects training-time citation markers like 【...】, 【id:0】,
# 【{"id":0,"cursor":0,"loc":0}】. Strip them — they're rendering noise.
_CITATION_NOISE_RE = re.compile(r"【[^】\n]{0,200}】")


def _clean_answer(s: str) -> str:
    if not s:
        return s
    s = _CITATION_NOISE_RE.sub("", s)
    # Collapse any runs of spaces created by stripping
    s = re.sub(r" {3,}", "  ", s)
    return s.strip()


# ----------------------------- Simple ask -----------------------------------

def ask_openrouter(fragment, question, model):
    if not API_KEY:
        return {"error": "OPENROUTER_API_KEY не задан"}
    model = model or fetch_top_model()
    user_msg = (
        f"Фрагмент учебника:\n\"\"\"\n{fragment.strip()}\n\"\"\"\n\n"
        f"Вопрос ученика: {question.strip()}"
    )
    content, err = _openrouter_chat(
        [
            {"role": "system", "content": SYSTEM_PROMPT_PLAIN},
            {"role": "user", "content": user_msg},
        ],
        model,
    )
    if err:
        return {"error": err, "model": model}
    return {"answer": _clean_answer(content or ""), "model": model}


# ----------------------------- Agent loop -----------------------------------

MAX_STEPS = 4


def ask_agent_stream(fragment, question, chapter_slug, model, history=None):
    """Generator: yields (event_type, payload) tuples.

    Event types:
      "model"   {"model": str}              — first event, current model id
      "thought" {"text": str}               — agent's chain-of-thought step
      "search"  {"query": str, "results"}   — search tool call + result snippets
      "read"    {"slug","title","chars","truncated"} or {"slug","error"}
      "invalid" {"raw": str}                — agent returned malformed step
      "fallback" {"raw": str}               — JSON parse failed, salvaged or raw
      "final"   {"answer","model","steps"}  — terminal success event
      "error"   {"error","model"}           — terminal failure event
    """
    if not API_KEY:
        yield "error", {"error": "OPENROUTER_API_KEY не задан"}
        return
    model = model or fetch_top_model()
    yield "model", {"model": model}

    _, chapters_meta = build_chunk_index()

    current_title = ""
    current_text = ""
    if chapter_slug:
        loaded = _load_chapter_raw(chapter_slug)
        if loaded:
            current_title, body = loaded
            if len(body) > 4500:
                body = body[:4500] + "\n\n[…глава обрезана]"
            current_text = body

    chapters_listing = "\n".join(
        f"- {c['slug']} — {c['title']}" for c in chapters_meta
    )

    initial_user = (
        f"Ученик читает главу: \"{current_title}\" (slug: {chapter_slug or '—'}).\n\n"
        f"Выделенный фрагмент:\n\"\"\"\n{fragment.strip()}\n\"\"\"\n\n"
        f"Полный текст текущей главы (для контекста):\n\"\"\"\n{current_text}\n\"\"\"\n\n"
        f"Список доступных глав (slug — title):\n{chapters_listing}\n\n"
        f"Вопрос ученика: {question.strip()}\n\n"
        f"Сделай первый шаг (JSON)."
    )

    messages = [{"role": "system", "content": AGENT_SYSTEM_PROMPT}]
    if history:
        for h in history[-6:]:
            if not isinstance(h, dict):
                continue
            role = h.get("role")
            content_ = h.get("content")
            if role in ("user", "assistant") and isinstance(content_, str) and content_.strip():
                msg = content_ if len(content_) < 3000 else content_[:3000] + "…"
                messages.append({"role": role, "content": msg})
    messages.append({"role": "user", "content": initial_user})

    for step in range(MAX_STEPS):
        content, err = _openrouter_chat(messages, model)
        if err:
            yield "error", {"error": err, "model": model}
            return

        parsed = _extract_json(content)
        if parsed is None:
            salvaged = _extract_answer_regex(content)
            if salvaged:
                yield "fallback", {"raw": "answer salvaged"}
                yield "final", {"answer": _clean_answer(salvaged), "model": model, "steps": step + 1}
                return
            yield "fallback", {"raw": content[:300]}
            yield "final", {"answer": _clean_answer(content or ""), "model": model, "steps": step + 1}
            return

        thought = (parsed.get("thought") or "").strip()
        if thought:
            yield "thought", {"text": thought}

        if parsed.get("answer"):
            yield "final", {"answer": _clean_answer(str(parsed["answer"])), "model": model, "steps": step + 1}
            return

        tool = (parsed.get("tool") or "").lower()
        if tool == "search":
            q = (parsed.get("query") or "").strip()
            results = tool_search(q, top_k=3, exclude_slug=chapter_slug)
            yield "search", {"query": q, "results": results}
            messages.append({"role": "assistant", "content": content})
            messages.append({"role": "user", "content": (
                f"Результат search({q!r}):\n```json\n"
                f"{json.dumps(results, ensure_ascii=False, indent=2)}\n```\n"
                f"Следующий шаг (JSON)."
            )})
        elif tool == "read":
            slug = (parsed.get("slug") or "").strip()
            res = tool_read_chapter(slug)
            if not res:
                yield "read", {"slug": slug, "error": "not found"}
                payload = json.dumps({"error": f"глава {slug!r} не найдена"}, ensure_ascii=False)
            else:
                yield "read", {
                    "slug": res["slug"], "title": res["title"],
                    "chars": len(res["text"]), "truncated": res["truncated"],
                }
                payload = json.dumps(res, ensure_ascii=False)
            messages.append({"role": "assistant", "content": content})
            messages.append({"role": "user", "content": (
                f"Результат read({slug!r}):\n```json\n{payload}\n```\nСледующий шаг (JSON)."
            )})
        else:
            yield "invalid", {"raw": str(parsed)[:200]}
            messages.append({"role": "assistant", "content": content})
            messages.append({"role": "user", "content": (
                "Неизвестное действие. Используй search/read или верни answer."
            )})

    # Force-final: до 2 попыток с нарастающей жёсткостью.
    force_prompts = [
        ("Шаги закончились. Дай финальный ответ ученику ПРОСТЫМ markdown-текстом "
         "(БЕЗ JSON, БЕЗ ```json, БЕЗ ключей thought/tool/slug/query). "
         "Можно $...$ и $$...$$ для формул."),
        ("ВНИМАНИЕ: не используй JSON и фигурные скобки. Ответь ученику обычным "
         "русским текстом в markdown. Никаких {\"thought\":...} — просто ответ."),
    ]
    text = ""
    for fp in force_prompts:
        messages.append({"role": "user", "content": fp})
        content, err = _openrouter_chat(messages, model)
        if err:
            yield "error", {"error": err, "model": model}
            return
        candidate = (content or "").strip()
        parsed = _extract_json(candidate)
        if parsed and isinstance(parsed.get("answer"), str) and parsed["answer"].strip():
            text = parsed["answer"].strip()
            break
        if not (candidate.startswith("{") or "```json" in candidate.lower()):
            text = candidate
            break
        salvaged = _extract_answer_regex(candidate)
        if salvaged:
            text = salvaged
            break
        messages.append({"role": "assistant", "content": content})
    if not text:
        text = "Не удалось сформировать финальный ответ — попробуй переформулировать вопрос."
    yield "final", {
        "answer": _clean_answer(text),
        "model": model,
        "steps": MAX_STEPS + 1,
    }


def ask_agent(fragment, question, chapter_slug, model, history=None):
    """Sync wrapper around ask_agent_stream — keeps non-streaming JSON callers working."""
    trace = []
    model_used = model
    for event_type, payload in ask_agent_stream(fragment, question, chapter_slug, model, history=history):
        if event_type == "model":
            model_used = payload.get("model") or model_used
            continue
        if event_type == "final":
            return {
                "answer": payload["answer"],
                "model": payload.get("model") or model_used,
                "trace": trace,
                "steps": payload.get("steps"),
            }
        if event_type == "error":
            return {"error": payload.get("error"), "model": payload.get("model") or model_used, "trace": trace}
        # Trace event — preserve original dict shape ({"type": ..., ...fields}).
        trace.append({"type": event_type, **payload})
    return {"error": "agent ended without final event", "trace": trace}


# ----------------------------- SSE plumbing ----------------------------------

class SSEStream:
    """Thread-safe writer for Server-Sent Events.

    Used so the agent generator (main thread) and the heartbeat thread can both
    push frames without interleaving bytes. Marks itself closed on any socket
    error so downstream loops can break cleanly without raising.
    """

    def __init__(self, wfile):
        self.wfile = wfile
        self.lock = threading.Lock()
        self.closed = False

    def _write(self, raw: bytes) -> None:
        if self.closed:
            return
        with self.lock:
            try:
                self.wfile.write(raw)
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                self.closed = True

    def event(self, event_type: str, payload) -> None:
        body = json.dumps(payload, ensure_ascii=False)
        self._write(f"event: {event_type}\ndata: {body}\n\n".encode("utf-8"))

    def ping(self) -> None:
        # SSE comment lines start with ":" and are silently consumed by clients —
        # exactly what we need to keep proxies/browsers from idling out.
        self._write(b": ping\n\n")


def _heartbeat_loop(stream: SSEStream, stop: threading.Event, interval: float = 8.0) -> None:
    while not stop.wait(interval):
        if stream.closed:
            return
        stream.ping()


# ----------------------------- HTTP handler ----------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        sys.stderr.write("[%s] %s\n" % (self.log_date_time_string(), fmt % args))

    def _send_json(self, obj, status=200):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _start_sse(self) -> SSEStream:
        # Force close-on-finish so the response body ends at TCP close. Python's
        # http.server doesn't emit chunked transfer encoding, and SSE has no
        # Content-Length, so without close-on-finish nginx forwards a chunked
        # stream that's never properly terminated → ERR_INCOMPLETE_CHUNKED_ENCODING
        # in Chromium and a stalled reader in our widget.
        self.close_connection = True
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-cache, no-transform")
        self.send_header("Connection", "close")
        # Tell nginx not to buffer — without this proxy_buffering would hold
        # events until the response completes, defeating the whole exercise.
        self.send_header("X-Accel-Buffering", "no")
        self.end_headers()
        return SSEStream(self.wfile)

    def do_GET(self):
        if self.path == "/api/model":
            return self._send_json({"model": fetch_top_model()})
        if self.path == "/healthz":
            return self._send_json({"ok": True, "chunks": len(build_chunk_index()[0])})
        return self._send_json({"error": "not found"}, status=404)

    def do_POST(self):
        try:
            length = int(self.headers.get("Content-Length", "0"))
            body = json.loads(self.rfile.read(length).decode("utf-8")) if length else {}
        except Exception as e:
            return self._send_json({"error": f"bad request: {e}"}, status=400)

        if self.path == "/api/ask":
            fragment = (body.get("fragment") or "").strip()
            question = (body.get("question") or "").strip()
            model = body.get("model") or None
            if not question:
                return self._send_json({"error": "Нужно question"}, status=400)
            if not fragment:
                fragment = "(фрагмент не выделен)"
            result = ask_openrouter(fragment, question, model)
            status = 500 if "error" in result and "answer" not in result else 200
            return self._send_json(result, status=status)

        if self.path == "/api/ask_agent":
            fragment = (body.get("fragment") or "").strip()
            question = (body.get("question") or "").strip()
            chapter_slug = (body.get("chapter_slug") or "").strip() or None
            model = body.get("model") or None
            history = body.get("history") or []
            if not question:
                return self._send_json({"error": "Нужно question"}, status=400)
            if not fragment:
                fragment = "(фрагмент не выделен — отвечай по тексту вопроса и контексту главы)"

            wants_sse = "text/event-stream" in (self.headers.get("Accept") or "").lower()
            if not wants_sse:
                result = ask_agent(fragment, question, chapter_slug, model, history=history)
                status = 500 if "error" in result and "answer" not in result else 200
                return self._send_json(result, status=status)

            stream = self._start_sse()
            # Open the channel immediately so the client knows the request is alive.
            stream.ping()
            stop = threading.Event()
            hb = threading.Thread(target=_heartbeat_loop, args=(stream, stop), daemon=True)
            hb.start()
            try:
                for event_type, payload in ask_agent_stream(
                    fragment, question, chapter_slug, model, history=history
                ):
                    stream.event(event_type, payload)
                    if stream.closed or event_type in ("final", "error"):
                        break
            except Exception as e:
                stream.event("error", {"error": f"server: {e}"})
            finally:
                stop.set()
                hb.join(timeout=1)
            return

        return self._send_json({"error": "not found"}, status=404)


class ThreadingServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    port = int(os.environ.get("PORT", 8766))
    host = os.environ.get("HOST", "127.0.0.1")
    print(f"sigma-assistant on http://{host}:{port}")
    print(f"OPENROUTER_API_KEY: {'set' if API_KEY else 'MISSING'}")
    chunks, chapters = build_chunk_index()
    print(f"Chunks: {len(chunks)}  Chapters: {len(chapters)}")
    ThreadingServer((host, port), Handler).serve_forever()
